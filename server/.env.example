# Copy to server/.env and adjust.

# Local docker compose replica set. directConnection=true connects straight to the
# single node instead of discovering members by their internal hostnames.
MONGODB_URI=mongodb://localhost:27017/taskflow?replicaSet=rs0&directConnection=true

PORT=4000

# The client origin allowed by CORS (Vite dev server locally, Vercel URL in prod).
CORS_ORIGIN=http://localhost:5173

# When true, the x-chaos-latency and x-chaos-fail-rate request headers can add
# delay and simulated 500s to mutating routes (used to demo rollback).
CHAOS_ENABLED=false
